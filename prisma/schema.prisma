// Home Page Settings (Text & Main Images)
model HomeSettings {
  id               String   @id @default("default")
  heroImage        String   @default("/herobg-img.webp")
  heroTitle        String   @default("Premium Curtains & Blinds in Abu Dhabi")
  heroSubtitle     String   @default("AL MAWASIM DECOR & CURTAINS provides custom curtains...")
  aboutImage1      String   @default("/home/home-Our-Specialize-01.webp")
  aboutImage2      String   @default("/home/home-Our-Specialize-02.webp")
  aboutTitle       String   @default("Trusted Curtains & Interior Decor Company in Abu Dhabi")
  aboutDescription String   @default("AL MAWASIM DECOR & CURTAINS specializes in premium...")
  statsProjects    Int      @default(500)
  statsSatisfaction Int     @default(100)
  updatedAt        DateTime @updatedAt
