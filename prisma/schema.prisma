  statsSatisfaction Int      @default(100)
  reasonsBadge      String   @default("Top 6 Reasons")
  reasonsTitle      String   @default("Why Choose Us")
  reasonsText       String   @default("Whether you are looking for custom curtains, roller blinds...")
  servicesBadge     String   @default("Services Process")
  servicesTitle     String   @default("Industries We Serve in Abu Dhabi")
  servicesText      String   @default("AL MAWASIM DECOR & CURTAINS provides custom curtains...")
  servicesImage     String   @default("/about-us/aboutl-us-services.png")
  updatedAt         DateTime @updatedAt
}
model Catalog {
  id          String   @id @default(uuid())
  title       String
  description String
  pdfUrl      String   // This will store the Google Drive file link
  thumbnail   String?  // Optional: an image for the catalog cover
  isActive    Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}