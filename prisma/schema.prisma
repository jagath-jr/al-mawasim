  // Section 1: Welcome & Grid
  welcomeBadge     String   @default("Welcome")
  welcomeTitle     String   @default("Professional Curtains, Flooring & Wallpaper Services in Abu Dhabi")
  welcomeText      String   @default("Welcome to AL MAWASIM DECOR & CURTAINS LLC...")
  gridImage1       String   @default("/about-us/aboutus-Welcome-img01.webp")
  gridImage2       String   @default("/about-us/aboutus-Welcome-img02.webp")
  statsProjects    Int      @default(500)
  statsSatisfaction Int     @default(100)

  // Section 2: Why Choose Us
  reasonsBadge     String   @default("Top 6 Reasons")
  reasonsTitle     String   @default("Why Choose Us")
  reasonsText      String   @default("Whether you are looking for custom curtains, roller blinds...")

  // Section 3: Services Process
  servicesBadge    String   @default("Services Process")
  servicesTitle    String   @default("Industries We Serve in Abu Dhabi")
  servicesText     String   @default("AL MAWASIM DECOR & CURTAINS provides custom curtains...")
