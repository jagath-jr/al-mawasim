  welcomeText       String   @default("Welcome to AL MAWASIM DECOR & CURTAINS LLC...")
  gridImage1        String   @default("/about-us/aboutus-Welcome-img01.webp")
  gridImage2        String   @default("/about-us/aboutus-Welcome-img02.webp")
